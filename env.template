# Vietnam Hearts Scheduler - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database connection URL
# For development: SQLite database in project root
# For production: PostgreSQL connection string (e.g., postgresql://user:pass@host:port/db)
DATABASE_URL=sqlite:///./dev.db

# =============================================================================
# API CONFIGURATION
# =============================================================================

# Port for the API server to run on
PORT=8080

# Base URL for the API (used for generating links)
API_URL=http://localhost:8080

# Environment: development, staging, production
ENVIRONMENT=development

# How far from the right-hand end of X-Forwarded-For the real client IP sits.
# 1 is correct when the service is invoked directly on its *.run.app URL, where
# Cloud Run appends the observed peer as the last entry. Set to 2 if a Google
# external Application Load Balancer is put in front, which appends
# "<client-ip>,<load-balancer-ip>". Getting this wrong either lets callers pick
# their own rate limit bucket or collapses every caller into one bucket.
# Derive the value from the deployment topology rather than from logs. The
# "clamping to the leftmost entry" warning fires only when a request carries
# fewer entries than this value, so a value set too low never warns at all, and
# the resolved client IP is logged as an `extra` field, which both log sinks drop.
TRUSTED_PROXY_HOPS=1

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

# Email address that will appear as the sender
# Example: noreply@vietnamhearts.org
EMAIL_SENDER=

# Gmail App Password for sending emails
# Generate this in your Google Account settings under Security > 2-Step Verification > App passwords
# This is NOT your regular Gmail password
GMAIL_APP_PASSWORD=

# =============================================================================
# CLOUD SCHEDULER CONFIGURATION
# =============================================================================

# Project and location of the Cloud Scheduler jobs whose cadence is owned by
# the CRON_* settings and applied by POST /admin/sync-cron-schedules.
# CLOUD_SCHEDULER_LOCATION must match SCHEDULER_REGION in scripts/deploy.config.
# GCP_PROJECT_ID is optional: leave it empty to use the project attached to
# Application Default Credentials (on Cloud Run, the deployed project), and set
# it only to point at a different project.
# The runtime service account needs roles/cloudscheduler.admin for the sync to
# work; without it the endpoint reports a per-job permission error.
GCP_PROJECT_ID=
CLOUD_SCHEDULER_LOCATION=asia-southeast1

# =============================================================================
# GOOGLE SHEETS CONFIGURATION
# =============================================================================

# Path to Google Service Account credentials JSON file
# The setup script will look for this at: secrets/google_credentials.json
# Optional: if the file doesn't exist, the app warns, ignores the stale path,
# and falls back to Application Default Credentials (e.g. on Cloud Run)
GOOGLE_APPLICATION_CREDENTIALS=secrets/google_credentials.json

# Google OAuth Client ID for Google Sheets API access
# Get this from Google Cloud Console > APIs & Services > Credentials
GOOGLE_OAUTH_CLIENT_ID=

# Google OAuth Client Secret for Google Sheets API access
# Get this from Google Cloud Console > APIs & Services > Credentials
GOOGLE_OAUTH_CLIENT_SECRET=

# Service Account Email for Google Sheets API access
# This is the email address of your Google Service Account
# Format: something@project-id.iam.gserviceaccount.com
SERVICE_ACCOUNT_EMAIL=

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================

# Supabase project URL
# Get this from your Supabase project dashboard
# Format: https://your-project-id.supabase.co
SUPABASE_URL=

# Supabase publishable key (safe to expose client-side)
# New API key format, replaces the legacy "anon" key.
# Get this from your Supabase project dashboard > Settings > API Keys
SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (private - keep secret!)
# New API key format, replaces the legacy "service_role" key.
# Get this from your Supabase project dashboard > Settings > API Keys
SUPABASE_SECRET_KEY=

# Supabase JWKS URL, used to verify user access tokens
# Format: https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# =============================================================================
# META (FACEBOOK MESSENGER) CONFIGURATION
# =============================================================================

# Meta app secret, used to verify the X-Hub-Signature-256 on every delivery
# Get this from developers.facebook.com > your app > App settings > Basic
# If unset, every webhook delivery is rejected with 403 and Meta disables the subscription
FACEBOOK_APP_SECRET=

# Shared secret you invent and paste into the Meta webhook subscription form
# Meta echoes it back during the handshake; if unset, verification can never succeed
FACEBOOK_VERIFY_TOKEN=

# Page access token used to send replies through the Send API
# Get this from developers.facebook.com > your app > Messenger > Settings > Access tokens
FACEBOOK_ACCESS_TOKEN=

# =============================================================================
# GEMINI CONFIGURATION
# =============================================================================

# Google Gemini API key for embeddings and chat responses
# Get this from https://aistudio.google.com/apikey
# If unset, the bot refuses to answer rather than guessing
GEMINI_API_KEY=

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# Custom template path for email templates (optional)
# If not set, defaults to templates/email/weekly-reminder-email.html
# EMAIL_TEMPLATES_PATH=

# Sentry DSN for error tracking (optional)
# If unset, Sentry is disabled entirely - no errors are sent anywhere.
# Also disabled whenever TESTING=true, so test runs never send events.
# Get this from your Sentry project settings > Client Keys (DSN)
SENTRY_DSN=

# Fraction of requests to sample for Sentry performance tracing (0.0-1.0)
# SENTRY_TRACES_SAMPLE_RATE=0.1

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================
#
# 1. Copy this file to .env: cp env.template .env
# 2. Fill in the required values above
# 3. For Google Sheets integration:
#    - Create a Google Cloud project
#    - Enable Google Sheets API
#    - Create a Service Account
#    - Download credentials JSON to secrets/google_credentials.json
# 4. For Supabase integration:
#    - Create a Supabase project
#    - Get your project URL and API keys
# 5. For email functionality:
#    - Set up Gmail App Password
#    - Configure sender email
#
# Required for production:
# - GMAIL_APP_PASSWORD
# - GOOGLE_OAUTH_CLIENT_ID
# - GOOGLE_OAUTH_CLIENT_SECRET
# - SERVICE_ACCOUNT_EMAIL
# - SUPABASE_URL
# - SUPABASE_PUBLISHABLE_KEY
# - SUPABASE_SECRET_KEY
#
# ============================================================================= 